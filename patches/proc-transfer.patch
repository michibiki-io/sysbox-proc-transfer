diff --git a/sysbox-fs/seccomp/proc_transfer.go b/sysbox-fs/seccomp/proc_transfer.go
new file mode 100644
index 0000000..a8dc582
--- /dev/null
+++ b/sysbox-fs/seccomp/proc_transfer.go
@@ -0,0 +1,160 @@
+package seccomp
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/sirupsen/logrus"
+	"golang.org/x/sys/unix"
+)
+
+// Nested proc mounts are built in the registered container's mapped user
+// namespace, then transferred with all protected submounts kernel-locked.
+// This path does not change the container's seccomp profile.
+func (m *mountSyscallInfo) processNestedProcMount() (*sysResponse, bool, error) {
+	helper := os.Getenv("SYSBOX_PROC_TRANSFER_HELPER")
+	if helper == "" {
+		return nil, false, nil
+	}
+	outer, err := m.cntr.InitProc().UserNsInode()
+	if err != nil {
+		return nil, true, err
+	}
+	user, err := m.processInfo.UserNsInode()
+	if err != nil {
+		return nil, true, err
+	}
+	if outer == user {
+		return nil, false, nil
+	}
+	reject := func(e syscall.Errno) (*sysResponse, bool, error) {
+		return m.tracer.createErrorResponse(m.reqId, e), true, nil
+	}
+	if m.root != "/" || m.Data != "" || !filepath.IsAbs(m.Target) {
+		return reject(syscall.ENOTSUP)
+	}
+	if !m.processInfo.IsSysAdminCapabilitySet() {
+		return reject(syscall.EPERM)
+	}
+	if m.uid < m.cntr.UID() || m.uid-m.cntr.UID() >= m.cntr.UidSize() || m.gid < m.cntr.GID() || m.gid-m.cntr.GID() >= m.cntr.GidSize() {
+		return reject(syscall.EPERM)
+	}
+	if m.cntr.IsImmutableMountpoint(m.Target) || m.cntr.IsImmutableOverlapMountpoint(m.Target) {
+		return reject(syscall.EPERM)
+	}
+	var files []*os.File
+	defer func() {
+		for _, f := range files {
+			f.Close()
+		}
+	}()
+	add := func(path string, flags int) error {
+		fd, e := unix.Open(path, flags|unix.O_CLOEXEC, 0)
+		if e != nil {
+			return e
+		}
+		files = append(files, os.NewFile(uintptr(fd), path))
+		return nil
+	}
+	outerBase := fmt.Sprintf("/proc/%d", m.cntr.InitPid())
+	targetBase := fmt.Sprintf("/proc/%d", m.pid)
+	// Absolute symlinks must resolve within the relevant container root,
+	// rather than against the daemon's host root.
+	outerRoot, err := unix.Open(outerBase+"/root", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, true, err
+	}
+	defer unix.Close(outerRoot)
+	targetRoot, err := unix.Open(targetBase+"/root", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, true, err
+	}
+	defer unix.Close(targetRoot)
+	addRooted := func(root int, path string, flags int) error {
+		fd, e := unix.Openat2(root, path, &unix.OpenHow{
+			Flags:   uint64(flags | unix.O_CLOEXEC),
+			Resolve: unix.RESOLVE_IN_ROOT | unix.RESOLVE_NO_MAGICLINKS,
+		})
+		if e != nil {
+			return e
+		}
+		files = append(files, os.NewFile(uintptr(fd), path))
+		return nil
+	}
+	paths := []string{outerBase + "/ns/user", outerBase + "/ns/mnt", targetBase + "/ns/user", targetBase + "/ns/mnt", targetBase + "/ns/pid"}
+	for _, p := range paths {
+		if err := add(p, unix.O_RDONLY); err != nil {
+			return nil, true, err
+		}
+	}
+	if err := addRooted(targetRoot, m.Target, unix.O_PATH|unix.O_DIRECTORY); err != nil {
+		return nil, true, err
+	}
+	if err := addRooted(outerRoot, "/", unix.O_PATH|unix.O_DIRECTORY); err != nil {
+		return nil, true, err
+	}
+	pfd, err := unix.PidfdOpen(int(m.pid), 0)
+	if err != nil {
+		return nil, true, err
+	}
+	files = append(files, os.NewFile(uintptr(pfd), "requester pidfd"))
+	args := []string{strconv.FormatUint(uint64(m.uid-m.cntr.UID()), 10), strconv.FormatUint(uint64(m.gid-m.cntr.GID()), 10), strconv.FormatUint(m.Flags, 10)}
+	protected := append([]string{}, m.tracer.service.mts.MountHelper().ProcMounts()...)
+	protected = append(protected, m.cntr.ProcRoPaths()...)
+	protected = append(protected, m.cntr.ProcMaskPaths()...)
+	seen := map[string]bool{}
+	for _, p := range protected {
+		if !strings.HasPrefix(p, "/proc/") || filepath.Clean(p) != p {
+			return reject(syscall.EINVAL)
+		}
+		if seen[p] {
+			continue
+		}
+		seen[p] = true
+		// Sources belong to the registered outer container, never an untrusted
+		// caller's possibly overmounted view of /proc.
+		err := addRooted(outerRoot, p, unix.O_PATH)
+		if err == syscall.ENOENT {
+			continue
+		}
+		if err != nil {
+			return nil, true, err
+		}
+		args = append(args, strings.TrimPrefix(p, "/proc/"))
+	}
+	if len(args) == 3 {
+		return reject(syscall.EPERM)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 25*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, helper, args...)
+	cmd.ExtraFiles = files
+	cmd.SysProcAttr = &syscall.SysProcAttr{Pdeathsig: syscall.SIGKILL}
+	guard, ok := m.tracer.service.nss.(interface {
+		WithChildReaperGuard(func() error) error
+	})
+	if !ok {
+		return reject(syscall.ENOTSUP)
+	}
+	var output []byte
+	err = guard.WithChildReaperGuard(func() error {
+		var waitErr error
+		output, waitErr = cmd.CombinedOutput()
+		return waitErr
+	})
+	if err != nil {
+		logrus.Warnf("protected proc transfer failed pid=%d: %s: %v", m.pid, output, err)
+		if e, ok := err.(*exec.ExitError); ok && e.ExitCode() > 0 && e.ExitCode() < 256 {
+			return reject(syscall.Errno(e.ExitCode()))
+		}
+		return reject(syscall.EIO)
+	}
+	return m.tracer.createSuccessResponse(m.reqId), true, nil
+}
