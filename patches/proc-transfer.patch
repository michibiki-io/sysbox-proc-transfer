@@ -26,6 +26,18 @@ type nsenterService struct {
 	reaper *zombieReaper
 }
 
+// WithChildReaperGuard reserves synchronous children for their own waiters.
+// The global Wait4(-1) sweep must not steal an exec.Cmd child's exit status.
+// RLock permits the helper's FUSE requests to start ordinary nsenters.
+func (s *nsenterService) WithChildReaperGuard(run func() error) error {
+	s.reaper.nsenterStarted()
+	defer func() {
+		s.reaper.nsenterEnded()
+		s.reaper.nsenterReapReq()
+	}()
+	return run()
+}
