+// SysfsPolicy snapshots all sysfs mounts, including OCI masks, read-only paths
+// and submounts nested beneath emulation. The registered parser is immutable.
+func (mi *mountInfoParser) SysfsPolicy() []domain.SysfsProtection {
+	var result []domain.SysfsProtection
+	for path, info := range mi.mpInfo {
+		if path != "/sys" && !strings.HasPrefix(path, "/sys/") {
+			continue
+		}
+		flags := uint64(0)
+		for name, bit := range map[string]uint64{"ro": unix.MS_RDONLY, "nosuid": unix.MS_NOSUID, "nodev": unix.MS_NODEV, "noexec": unix.MS_NOEXEC} {
+			for _, options := range []map[string]string{info.Options, info.VfsOptions} {
+				if _, ok := options[name]; ok {
+					flags |= bit
+				}
+			}
+		}
+		emulated := false
+		for _, managed := range SysfsMounts {
+			if managed == path {
+				emulated = true
+				break
+			}
+		}
+		decoded := strings.NewReplacer(`\040`, " ", `\011`, "\t", `\012`, "\n", `\134`, `\`).Replace(path)
+		result = append(result, domain.SysfsProtection{Path: decoded, MountID: info.MountID, Inode: info.MpInode, FsType: info.FsType, Root: strings.NewReplacer(`\040`, " ", `\011`, "\t", `\012`, "\n", `\134`, `\`).Replace(info.Root), Flags: flags, Emulated: info.FsType == "fuse" && info.Source == "sysboxfs" && emulated, ReadonlyNetAlias: info.FsType == "fuse" && info.Source == "sysboxfs" && info.Root == path && domain.SysfsNetworkPath(decoded) && flags&unix.MS_RDONLY != 0})
+	}
+	return result
+}
