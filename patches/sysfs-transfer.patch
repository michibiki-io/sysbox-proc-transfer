diff --git a/sysbox-fs/domain/sysfs.go b/sysbox-fs/domain/sysfs.go
new file mode 100644
--- /dev/null
+++ b/sysbox-fs/domain/sysfs.go
@@ -0,0 +1,25 @@
+// Copyright 2026 michibiki.io.
+// SPDX-License-Identifier: Apache-2.0
+
+package domain
+
+// SysfsProtection is immutable registration-time mount metadata. Every source
+// must still match its registered mount ID and flag floor when acquired.
+// Registration capture does not collect inodes (Inode is normally zero); the
+// helper compares pinned source FD device/inode with its clone at use time.
+type SysfsProtection struct {
+	Path             string
+	MountID          int
+	Inode            Inode
+	Emulated         bool
+	FsType           string
+	Root             string
+	Flags            uint64
+	ReadonlyNetAlias bool
+}
+
+// SysfsNetworkPath is deliberately limited to the existing virtual-net handler.
+func SysfsNetworkPath(path string) bool {
+	const base = "/sys/devices/virtual/net"
+	return path == base || (len(path) > len(base) && path[:len(base)+1] == base+"/")
+}
