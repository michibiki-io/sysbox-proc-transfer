diff --git a/sysbox-fs/sysfstransfer/transfer.go b/sysbox-fs/sysfstransfer/transfer.go
new file mode 100644
--- /dev/null
+++ b/sysbox-fs/sysfstransfer/transfer.go
@@ -0,0 +1,477 @@
+// Copyright 2026 michibiki.io.
+// SPDX-License-Identifier: Apache-2.0
+
+// Package sysfstransfer acquires trusted descriptors for the separate sysfs
+// protocol. It never enters namespaces or changes mounts in the Go daemon.
+package sysfstransfer
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/nestybox/sysbox-fs/domain"
+	"golang.org/x/sys/unix"
+)
+
+const PIDFDThread = 0x80
+const allowed = unix.MS_RDONLY | unix.MS_NOSUID | unix.MS_NODEV | unix.MS_NOEXEC | unix.MS_RELATIME | unix.MS_STRICTATIME | unix.MS_SILENT | unix.MS_LAZYTIME
+
+func Validate(flags uint64, data string) error {
+	if data != "" || flags & ^uint64(allowed) != 0 || flags&unix.MS_RELATIME != 0 && flags&unix.MS_STRICTATIME != 0 {
+		return syscall.EINVAL
+	}
+	return nil
+}
+
+// Plan orders parents before children; recursive source clones also retain
+// submounts. Required metadata is never silently skipped on acquisition failure.
+func Plan(policy []domain.SysfsProtection, backing bool) ([]domain.SysfsProtection, uint64, error) {
+	var result []domain.SysfsProtection
+	var floor uint64
+	root := false
+	seen := map[string]bool{}
+	for _, p := range policy {
+		if filepath.Clean(p.Path) != p.Path || p.MountID <= 0 || seen[p.Path] {
+			return nil, 0, syscall.EINVAL
+		}
+		seen[p.Path] = true
+		if p.ReadonlyNetAlias && (!domain.SysfsNetworkPath(p.Path) || p.FsType != "fuse" || p.Flags&unix.MS_RDONLY == 0 || p.Emulated) {
+			return nil, 0, syscall.EINVAL
+		}
+		if p.Path == "/sys" {
+			// Fresh sysfs cannot reconstruct a whole-root mask or restricted bind.
+			if p.FsType != "sysfs" || p.Root != "/" {
+				return nil, 0, syscall.ENOTSUP
+			}
+			root = true
+			floor = p.Flags & uint64(unix.MS_RDONLY|unix.MS_NOSUID|unix.MS_NODEV|unix.MS_NOEXEC)
+			continue
+		}
+		if !strings.HasPrefix(p.Path, "/sys/") {
+			return nil, 0, syscall.EINVAL
+		}
+		// The FUSE net handler replaces only its own emulation ancestor. All OCI
+		// masks/RO mounts, including descendants inside that ancestor, remain.
+		if backing && p.Path == "/sys/devices/virtual" && p.Emulated {
+			continue
+		}
+		if backing && domain.SysfsNetworkPath(p.Path) && (p.Emulated || p.FsType == "fuse" && !p.ReadonlyNetAlias) {
+			return nil, 0, syscall.ENOTSUP
+		}
+		result = append(result, p)
+	}
+	if !root || len(result) > 128 {
+		return nil, 0, syscall.EPERM
+	}
+	sort.Slice(result, func(i, j int) bool { return result[i].Path < result[j].Path })
+	return result, floor, nil
+}
+
+type Request struct {
+	Files []*os.File
+	Args  []string
+}
+
+func (r *Request) Close() {
+	for _, f := range r.Files {
+		f.Close()
+	}
+}
+
+// pinTask anchors proc lookups before opening PIDFD_THREAD. Even if the task
+// exits between these steps, namespace reads through the anchor fail rather
+// than switching to a replacement task. Polling is an early exit check only;
+// concurrent exec/setns and the final check-to-use window remain non-atomic.
+func pinTask(tid uint32) (dir, thread int, err error) {
+	dir, err = unix.Open(fmt.Sprintf("/proc/%d", tid), unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return -1, -1, fmt.Errorf("pin task tid=%d: %w", tid, err)
+	}
+	thread, err = unix.PidfdOpen(int(tid), PIDFDThread)
+	if err == nil {
+		err = taskAlive(thread)
+	}
+	if err != nil {
+		unix.Close(dir)
+		if thread >= 0 {
+			unix.Close(thread)
+		}
+		return -1, -1, fmt.Errorf("PIDFD_THREAD tid=%d: %w", tid, err)
+	}
+	return dir, thread, nil
+}
+
+func taskAlive(thread int) error {
+	fds := []unix.PollFd{{Fd: int32(thread), Events: unix.POLLIN}}
+	for {
+		n, err := unix.Poll(fds, 0)
+		if err == unix.EINTR {
+			continue
+		}
+		if err != nil {
+			return err
+		}
+		if n != 0 {
+			if fds[0].Revents&unix.POLLNVAL != 0 {
+				return syscall.EBADF
+			}
+			return syscall.ESRCH
+		}
+		return nil
+	}
+}
+
+func Acquire(c domain.ContainerIface, tid, uid, gid uint32, target string, flags uint64, operation string, channel *os.File) (_ *Request, err error) {
+	if c == nil || !c.IsRegistrationCompleted() || uid < c.UID() || uid-c.UID() >= c.UidSize() || gid < c.GID() || gid-c.GID() >= c.GidSize() {
+		return nil, syscall.EPERM
+	}
+	if err = Validate(flags, ""); err != nil {
+		return nil, err
+	}
+	snapshot, ok := c.(interface {
+		SysfsPolicy() []domain.SysfsProtection
+	})
+	if !ok {
+		return nil, syscall.ENOTSUP
+	}
+	policy, floor, err := Plan(snapshot.SysfsPolicy(), channel != nil)
+	if err != nil {
+		return nil, err
+	}
+	r := &Request{Args: []string{strconv.FormatUint(uint64(uid-c.UID()), 10), strconv.FormatUint(uint64(gid-c.GID()), 10), strconv.FormatUint(flags|floor, 10)}}
+	defer func() {
+		if err != nil {
+			r.Close()
+		}
+	}()
+	// A proc task directory pins the kernel task identity, so subsequent openat
+	// calls cannot silently resolve a recycled numeric TID. Acquire the thread
+	// pidfd before reading namespaces/root and retain it through helper launch.
+	requester, thread, err := pinTask(tid)
+	if err != nil {
+		return nil, err
+	}
+	defer unix.Close(requester)
+	defer func() {
+		if thread >= 0 {
+			unix.Close(thread)
+		}
+	}()
+	outer, e := unix.Open(fmt.Sprintf("/proc/%d", c.InitPid()), unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if e != nil {
+		return nil, e
+	}
+	defer unix.Close(outer)
+	add := func(root int, path string, flags int) error {
+		fd, e := unix.Openat(root, path, flags|unix.O_CLOEXEC, 0)
+		if e != nil {
+			return fmt.Errorf("pin task %s: %w", path, e)
+		}
+		r.Files = append(r.Files, os.NewFile(uintptr(fd), path))
+		return nil
+	}
+	// The original notification/FUSE TID is used everywhere, never TGID.
+	for _, p := range []struct {
+		root int
+		path string
+	}{{outer, "ns/user"}, {outer, "ns/mnt"}, {requester, "ns/user"}, {requester, "ns/mnt"}, {requester, "ns/net"}} {
+		if err = add(p.root, p.path, unix.O_RDONLY); err != nil {
+			return nil, err
+		}
+	}
+	outerRoot, e := unix.Openat(outer, "root", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if e != nil {
+		return nil, e
+	}
+	defer unix.Close(outerRoot)
+	rooted := func(root int, path string, flags int) error {
+		fd, e := unix.Openat2(root, path, &unix.OpenHow{Flags: uint64(flags | unix.O_CLOEXEC), Resolve: unix.RESOLVE_IN_ROOT | unix.RESOLVE_NO_MAGICLINKS})
+		if e != nil {
+			return fmt.Errorf("pin rooted %s: %w", path, e)
+		}
+		r.Files = append(r.Files, os.NewFile(uintptr(fd), path))
+		return nil
+	}
+	if channel != nil {
+		fd, e := unix.Dup(int(channel.Fd()))
+		if e != nil {
+			return nil, e
+		}
+		unix.CloseOnExec(fd)
+		r.Files = append(r.Files, os.NewFile(uintptr(fd), "backing channel"))
+		if filepath.Clean(target) != target || !domain.SysfsNetworkPath(target) || (operation != "lookup" && operation != "open") {
+			return nil, syscall.EINVAL
+		}
+		r.Args = append(r.Args, "--"+operation+"="+strings.TrimPrefix(target, "/sys/"))
+	} else {
+		root, e := unix.Openat(requester, "root", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+		if e != nil {
+			return nil, e
+		}
+		defer unix.Close(root)
+		if !filepath.IsAbs(target) || filepath.Clean(target) != target {
+			return nil, syscall.EINVAL
+		}
+		if err = rooted(root, target, unix.O_PATH|unix.O_DIRECTORY); err != nil {
+			return nil, err
+		}
+	}
+	if err = rooted(outerRoot, "/", unix.O_PATH|unix.O_DIRECTORY); err != nil {
+		return nil, err
+	}
+	r.Files = append(r.Files, os.NewFile(uintptr(thread), "requester thread"))
+	thread = -1 // ownership transferred to Request, preserving protocol FD10
+	// Verify the root floor source too. Mount IDs prevent replacement by another
+	// mount with a coincidentally identical inode. FUSE inode 0 is intentionally
+	// not recorded by upstream; its registered mount ID remains mandatory.
+	verify := func(p domain.SysfsProtection) error {
+		f := r.Files[len(r.Files)-1]
+		var fs unix.Statfs_t
+		if e := unix.Fstatfs(int(f.Fd()), &fs); e != nil {
+			return e
+		}
+		floor := p.Flags & uint64(unix.MS_RDONLY|unix.MS_NOSUID|unix.MS_NODEV|unix.MS_NOEXEC)
+		if uint64(fs.Flags)&floor != floor {
+			return syscall.ESTALE
+		}
+		var st unix.Stat_t
+		if e := unix.Fstat(int(f.Fd()), &st); e != nil {
+			return e
+		}
+		if p.Inode != 0 && uint64(st.Ino) != uint64(p.Inode) {
+			return syscall.ESTALE
+		}
+		info, e := os.ReadFile(fmt.Sprintf("/proc/self/fdinfo/%d", f.Fd()))
+		if e != nil {
+			return e
+		}
+		var id int
+		for _, line := range strings.Split(string(info), "\n") {
+			if strings.HasPrefix(line, "mnt_id:") {
+				_, e = fmt.Sscanf(line, "mnt_id: %d", &id)
+				if e != nil {
+					return e
+				}
+			}
+		}
+		if id != p.MountID {
+			return syscall.ESTALE
+		}
+		return nil
+	}
+	for _, p := range snapshot.SysfsPolicy() {
+		if p.Path == "/sys" {
+			if err = rooted(outerRoot, p.Path, unix.O_PATH); err != nil {
+				return nil, err
+			}
+			if err = verify(p); err != nil {
+				return nil, err
+			}
+			r.Files[len(r.Files)-1].Close()
+			r.Files = r.Files[:len(r.Files)-1]
+		}
+	}
+	for _, p := range policy {
+		if err = rooted(outerRoot, p.Path, unix.O_PATH); err != nil {
+			return nil, err
+		}
+		if err = verify(p); err != nil {
+			return nil, fmt.Errorf("registered sysfs source %s: %w", p.Path, err)
+		}
+		name := strings.TrimPrefix(p.Path, "/sys/")
+		if channel != nil && p.ReadonlyNetAlias {
+			name = "@ro:" + name
+		}
+		r.Args = append(r.Args, name)
+	}
+	if err = taskAlive(int(r.Files[7].Fd())); err != nil {
+		return nil, err
+	}
+	return r, nil
+}
+
+func Errno(err error) syscall.Errno {
+	var e syscall.Errno
+	if errors.As(err, &e) {
+		return e
+	}
+	var exit *exec.ExitError
+	if errors.As(err, &exit) && exit.ExitCode() > 0 && exit.ExitCode() < 256 {
+		return syscall.Errno(exit.ExitCode())
+	}
+	return syscall.EIO
+}
+
+func Run(ctx context.Context, helper string, r *Request, guard interface{ WithChildReaperGuard(func() error) error }, launch func(func() ([]byte, error)) ([]byte, error)) error {
+	if !filepath.IsAbs(helper) {
+		return syscall.EINVAL
+	}
+	cmd := exec.CommandContext(ctx, helper, r.Args...)
+	cmd.ExtraFiles = r.Files
+	cmd.Env = []string{}
+	cmd.SysProcAttr = &syscall.SysProcAttr{Pdeathsig: syscall.SIGKILL}
+	return guard.WithChildReaperGuard(func() error {
+		out, err := launch(cmd.CombinedOutput)
+		if err != nil {
+			return fmt.Errorf("sysfs helper: %s: %w", out, err)
+		}
+		return nil
+	})
+}
+
+// Setup failures must not look like missing resources: libc treats ENOENT from
+// readdir as EOF. Preserve the original diagnostic while reporting EIO.
+func backingSetupError(err error) error {
+	if e := Errno(err); e == syscall.ENOENT || e == syscall.ENOTDIR {
+		return fmt.Errorf("backing setup: %v: %w", err, syscall.EIO)
+	}
+	return err
+}
+
+func backingHelperError(err error) error {
+	var exit *exec.ExitError
+	if errors.As(err, &exit) {
+		// Only the helper's final resource open may emit these reserved statuses.
+		switch exit.ExitCode() {
+		case 200:
+			return fmt.Errorf("%v: %w", err, syscall.ENOENT)
+		case 201:
+			return fmt.Errorf("%v: %w", err, syscall.ENOTDIR)
+		}
+	}
+	return backingSetupError(err)
+}
+
+// OpenBacking returns a single resource, opened under the caller's mapped
+// credentials. No userspace cache; pins and private view expire per operation.
+func OpenBacking(c domain.ContainerIface, tid, uid, gid uint32, path, operation, helper string, nss interface{}) (*os.File, error) {
+	guard, ok := nss.(interface{ WithChildReaperGuard(func() error) error })
+	if !ok {
+		return nil, syscall.ENOTSUP
+	}
+	pair, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_SEQPACKET|unix.SOCK_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	parent := os.NewFile(uintptr(pair[0]), "backing receive")
+	child := os.NewFile(uintptr(pair[1]), "backing send")
+	defer parent.Close()
+	defer child.Close()
+	r, err := Acquire(c, tid, uid, gid, path, unix.MS_RDONLY, operation, child)
+	if err != nil {
+		return nil, backingSetupError(err)
+	}
+	defer r.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 25*time.Second)
+	defer cancel()
+	err = Run(ctx, helper, r, guard, func(run func() ([]byte, error)) ([]byte, error) { return run() })
+	if err != nil {
+		return nil, backingHelperError(err)
+	}
+	// Read after successful wait: one small SCM_RIGHTS packet cannot fill socket.
+	// Nonblocking receive prevents a misconfigured helper that exits without send
+	// from hanging on our own still-open child descriptor.
+	b := make([]byte, 1)
+	oob := make([]byte, unix.CmsgSpace(4))
+	n, on, flags, _, err := unix.Recvmsg(pair[0], b, oob, unix.MSG_CMSG_CLOEXEC|unix.MSG_DONTWAIT)
+	if err != nil {
+		return nil, syscall.EIO
+	}
+	msgs, err := unix.ParseSocketControlMessage(oob[:on])
+	if err != nil {
+		return nil, syscall.EIO
+	}
+	var fds []int
+	for _, m := range msgs {
+		rights, e := unix.ParseUnixRights(&m)
+		if e != nil {
+			err = e
+		} else {
+			fds = append(fds, rights...)
+		}
+	}
+	if err != nil || n != 1 || b[0] != 'F' || flags&unix.MSG_CTRUNC != 0 || len(fds) != 1 {
+		for _, fd := range fds {
+			unix.Close(fd)
+		}
+		return nil, syscall.EIO
+	}
+	return os.NewFile(uintptr(fds[0]), filepath.Base(path)), nil
+}
+
+// OwnMetadataTask recognizes only this daemon's actual thread or its direct
+// child inode worker. The host-root FUSE header is checked by the handler. A
+// pinned task directory and early thread pidfd prevent numeric PID reuse from
+// redirecting the status read. Tgid is compared for ownership, never substituted.
+func OwnMetadataTask(tid uint32) bool { return ownMetadataTask(tid, false) }
+
+// Construction metadata is permitted only before the helper clears capabilities.
+func OwnMetadataConstructor(tid uint32) bool { return ownMetadataTask(tid, true) }
+
+func ownMetadataTask(tid uint32, requireAdmin bool) bool {
+	dir, thread, err := pinTask(tid)
+	if err != nil {
+		return false
+	}
+	defer unix.Close(dir)
+	defer unix.Close(thread)
+	fd, err := unix.Openat(dir, "status", unix.O_RDONLY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return false
+	}
+	f := os.NewFile(uintptr(fd), "metadata task status")
+	defer f.Close()
+	data, err := io.ReadAll(io.LimitReader(f, 16384))
+	if err != nil {
+		return false
+	}
+	own, admin := metadataIdentity(data, requireAdmin)
+	if !own || (requireAdmin && !admin) {
+		return false
+	}
+	if requireAdmin {
+		// Only a direct child helper of this daemon may construct metadata,
+		// with capabilities still present and a real pidfd in FD10.
+		fd, e := unix.Openat(dir, "fdinfo/10", unix.O_RDONLY|unix.O_CLOEXEC, 0)
+		if e != nil {
+			return false
+		}
+		pf := os.NewFile(uintptr(fd), "constructor pidfd metadata")
+		info, e := io.ReadAll(io.LimitReader(pf, 4096))
+		pf.Close()
+		if e != nil || !strings.Contains(string(info), "\nPid:") {
+			return false
+		}
+	}
+	return own && (!requireAdmin || admin) && taskAlive(thread) == nil
+}
+
+// Constructor metadata is limited to the direct helper, not its locker child.
+// Host metadata also permits this daemon's own threads.
+func metadataIdentity(data []byte, requireAdmin bool) (bool, bool) {
+	own, admin := false, false
+	for _, line := range strings.Split(string(data), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 2 && fields[0] == "CapEff:" {
+			bits, e := strconv.ParseUint(fields[1], 16, 64)
+			admin = e == nil && bits&(1<<21) != 0
+		}
+		if len(fields) == 2 && (fields[0] == "Tgid:" || fields[0] == "PPid:") {
+			id, err := strconv.Atoi(fields[1])
+			if err == nil && id == os.Getpid() && (!requireAdmin || fields[0] == "PPid:") {
+				own = true
+			}
+		}
+	}
+	return own, admin
+}
