+
+// Errors with a genuine missing path keep hiding semantics. Operational errors
+// are not ENOENT: libc readdir treats that errno as a successful empty result.
+func networkError(err error) error {
+	var e syscall.Errno
+	if errors.As(err, &e) {
+		return fuse.Errno(e)
+	}
+	return fuse.EIO
+}
+func networkUncached(path string) bool {
+	return os.Getenv("SYSBOX_SYSFS_TRANSFER_HELPER") != "" && domain.SysfsNetworkPath(path)
+}
+
+// ReadDirAllUncached prevents per-handle directory data from crossing Network namespaces.
+func (d *Dir) ReadDirAllUncached() bool { return networkUncached(d.path) }
+
+// Stable FUSE identities keep native OCI submounts attached to their covered
+// dentries even with TTL0 and per-request metadata refresh. Never reuse nodeDB
+// lookup results. The fresh node carries only this request's checked attributes;
+// the retained identity's Getattr/Read/Open dispatch still reauthorizes each PID.
+func (s *fuseServer) networkLookupNode(req *domain.HandlerRequest, attr *fuse.Attr, info os.FileInfo) fs.Node {
+	s.Lock()
+	defer s.Unlock()
+	if s.networkIdentities == nil {
+		s.networkIdentities = make(map[string]fs.Node)
+	}
+	identity := s.networkIdentities[req.Path]
+	kind := os.FileMode(0)
+	if identity != nil {
+		kind = identity.(interface{ Mode() os.FileMode }).Mode().Type()
+		attr.Inode = identity.(interface{ LookupProtocolInode() uint64 }).LookupProtocolInode()
+	} else if info.IsDir() {
+		kind = os.ModeDir
+	} else if info.Mode()&os.ModeSymlink != 0 {
+		kind = os.ModeSymlink
+	}
+	attr.Mode = attr.Mode & ^os.ModeType | kind
+	var fresh fs.Node
+	var file *File
+	if kind&os.ModeDir != 0 {
+		dir := NewDir(req, attr, s)
+		fresh = dir
+		file = &dir.File
+	} else {
+		file = NewFile(req, attr, s)
+		fresh = file
+	}
+	if identity == nil {
+		identity = fresh
+		s.networkIdentities[req.Path] = identity
+	}
+	file.lookupIdentity = identity
+	return fresh
+}
+
+// networkProtectionLookup keeps a mounted protection's covered dentry valid when
+// this caller cannot obtain its network view. It returns immutable, read-only
+// traversal metadata, never a saved view or resource attributes. Mounted dentries
+// pin the existing protocol identity; an unknown identity is not manufactured.
+func (s *fuseServer) networkProtectionLookup(req *domain.HandlerRequest) (fs.Node, bool) {
+	if req.Container == nil {
+		return nil, false
+	}
+	snapshot, ok := req.Container.(interface {
+		SysfsSourceAncestor(string) (bool, bool, uint32, uint32)
+	})
+	if !ok {
+		return nil, false
+	}
+	ready, ancestor, _, _ := snapshot.SysfsSourceAncestor(req.Path)
+	if !ready || !ancestor {
+		return nil, false
+	}
+	s.RLock()
+	identity := s.networkIdentities[req.Path]
+	s.RUnlock()
+	if identity == nil {
+		return nil, false
+	}
+	kind := identity.(interface{ Mode() os.FileMode }).Mode().Type()
+	mode := os.FileMode(0444)
+	if kind&os.ModeDir != 0 {
+		mode = 0555
+	} else if kind&os.ModeSymlink != 0 {
+		mode = 0555
+	}
+	attr := &fuse.Attr{Inode: identity.(interface{ LookupProtocolInode() uint64 }).LookupProtocolInode(), Mode: kind | mode, Nlink: 1}
+	req.SkipIdRemap = true // immutable host-root metadata remains nobody in the container
+	var node fs.Node
+	var file *File
+	if kind&os.ModeDir != 0 {
+		dir := NewDir(req, attr, s)
+		node, file = dir, &dir.File
+	} else {
+		file = NewFile(req, attr, s)
+		node = file
+	}
+	file.lookupIdentity = identity
+	return node, true
+}
