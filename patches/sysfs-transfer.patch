+// CaptureSysfsPolicy runs at the pre-exec creation-time update, before container code
+// can change policy. It reads kernel metadata only: no FUSE lookup or nsenter
+// is allowed here, so first-ever network reads cannot recursively initialize.
+func (mts *MountService) CaptureSysfsPolicy(pid uint32) ([]domain.SysfsProtection, error) {
+	data, err := os.ReadFile(fmt.Sprintf("/proc/%d/mountinfo", pid))
+	if err != nil {
+		return nil, err
+	}
+	parser, err := newMountInfoParser(nil, nil, false, true, false, mts)
+	if err != nil {
+		return nil, err
+	}
+	if err = parser.parseData(data); err != nil {
+		return nil, err
+	}
+	policy := parser.SysfsPolicy()
+	for _, entry := range policy {
+		if entry.Path == "/sys" {
+			return policy, nil
+		}
+	}
+	return nil, fmt.Errorf("registered pre-exec sysfs root missing")
+}
