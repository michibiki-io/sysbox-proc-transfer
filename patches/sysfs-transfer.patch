new file mode 100644
--- /dev/null
+++ b/sysbox-fs/handler/implementations/sysfsNetwork.go
@@ -0,0 +1,93 @@
+// Copyright 2026 michibiki.io.
+// SPDX-License-Identifier: Apache-2.0
+
+package implementations
+
+import (
+	"os"
+	"path/filepath"
+	"syscall"
+	"time"
+
+	"github.com/nestybox/sysbox-fs/domain"
+	"github.com/nestybox/sysbox-fs/sysfstransfer"
+	"github.com/sirupsen/logrus"
+)
+
+func sysfsNetworkEnabled(path string, req *domain.HandlerRequest) bool {
+	return req.Container != nil && !req.Container.Ctime().IsZero() && os.Getenv("SYSBOX_SYSFS_TRANSFER_HELPER") != "" && domain.SysfsNetworkPath(path)
+}
+func (h *PassThrough) networkResource(n domain.IOnodeIface, req *domain.HandlerRequest, operation string) (*os.File, error) {
+	f, err := sysfstransfer.OpenBacking(req.Container, req.Pid, req.Uid, req.Gid, n.Path(), operation, os.Getenv("SYSBOX_SYSFS_TRANSFER_HELPER"), h.Service.NSenterService())
+	if err != nil {
+		logrus.Warnf("sysfs-backing tid=%d path=%s: %v", req.Pid, n.Path(), err)
+		return nil, sysfstransfer.Errno(err)
+	}
+	return f, nil
+}
+func (h *PassThrough) networkLookup(n domain.IOnodeIface, req *domain.HandlerRequest) (os.FileInfo, error) {
+	f, err := h.networkResource(n, req, "lookup")
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil {
+		return nil, err
+	}
+	// fstat runs in the daemon User namespace. Preserve SysDevicesVirtual's
+	// SkipIdRemap policy: host root IDs become nobody in the mapped container,
+	// rather than advertising the mapped Network owner's IDs as caller-owned.
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok {
+		return nil, syscall.EIO
+	}
+	normalized := *stat
+	normalized.Uid, normalized.Gid = 0, 0
+	req.SkipIdRemap = true
+	return domain.FileInfo{Fname: info.Name(), Fsize: info.Size(), Fmode: info.Mode(), FmodTime: info.ModTime(), FisDir: info.IsDir(), Fsys: &normalized}, nil
+}
+func (h *PassThrough) networkOpen(n domain.IOnodeIface, req *domain.HandlerRequest) (bool, error) {
+	// Preserve the virtual-net handler's absence of write privileges. This path
+	// cannot open writable descriptors, create files or follow symlinks out of net.
+	if n.OpenFlags()&(syscall.O_ACCMODE|syscall.O_CREAT|syscall.O_TRUNC|syscall.O_APPEND) != 0 {
+		return false, syscall.EACCES
+	}
+	f, err := h.networkResource(n, req, "open")
+	if err != nil {
+		return false, err
+	}
+	f.Close()
+	return false, nil
+}
+
+// A host-root inode worker traverses FUSE on behalf of trusted source pinning.
+// It cannot construct a caller network view (its User namespace is the host).
+// Return synthetic directory metadata only for ancestors of registered mounts;
+// the final source itself is a native submount and is verified by mount ID/FD.
+// This path performs no mounts, reads, enumeration, symlink or write operations.
+func networkSourceLookup(path string, req *domain.HandlerRequest) (os.FileInfo, bool, error) {
+	if os.Getenv("SYSBOX_SYSFS_TRANSFER_HELPER") == "" || req.Container == nil || !domain.SysfsNetworkPath(path) {
+		return nil, false, nil
+	}
+	snapshot, ok := req.Container.(interface {
+		SysfsSourceAncestor(string) (bool, bool, uint32, uint32)
+	})
+	if !ok {
+		return nil, false, nil
+	}
+	ready, ancestor, uid, gid := snapshot.SysfsSourceAncestor(path)
+	if !ready {
+		return nil, false, nil
+	} // unchanged trusted pre-exec bootstrap
+	host := req.Uid == 0 && req.Gid == 0
+	constructor := req.Uid == uid && req.Gid == gid && sysfstransfer.OwnMetadataConstructor(req.Pid)
+	if !host && !constructor {
+		return nil, false, nil
+	}
+	if !ancestor || !sysfstransfer.OwnMetadataTask(req.Pid) {
+		return nil, true, syscall.EPERM
+	}
+	req.SkipIdRemap = true
+	return domain.FileInfo{Fname: filepath.Base(path), Fmode: os.ModeDir | 0555, FisDir: true, FmodTime: time.Now()}, true, nil
+}
