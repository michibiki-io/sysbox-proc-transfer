new file mode 100644
--- /dev/null
+++ b/sysbox-fs/seccomp/sysfs_transfer.go
@@ -0,0 +1,58 @@
+// Copyright 2026 michibiki.io.
+// SPDX-License-Identifier: Apache-2.0
+
+package seccomp
+
+import (
+	"context"
+	"os"
+	"syscall"
+	"time"
+
+	"github.com/nestybox/sysbox-fs/sysfstransfer"
+	"github.com/sirupsen/logrus"
+)
+
+func (m *mountSyscallInfo) processNestedSysMount() (*sysResponse, bool, error) {
+	helper := os.Getenv("SYSBOX_SYSFS_TRANSFER_HELPER")
+	if helper == "" {
+		return nil, false, nil
+	}
+	reject := func(err error) (*sysResponse, bool, error) {
+		logrus.Warnf("sysfs-transfer tid=%d: %v", m.pid, err)
+		return m.tracer.createErrorResponse(m.reqId, sysfstransfer.Errno(err)), true, nil
+	}
+	outer, err := m.cntr.InitProc().UserNsInode()
+	if err != nil {
+		return reject(err)
+	}
+	user, err := m.processInfo.UserNsInode()
+	if err != nil {
+		return reject(err)
+	}
+	if outer == user {
+		return nil, false, nil
+	}
+	if err = sysfstransfer.Validate(m.Flags, m.Data); err != nil {
+		return reject(err)
+	}
+	if m.root != "/" || !m.processInfo.IsSysAdminCapabilitySet() || m.cntr.IsImmutableMountpoint(m.Target) || m.cntr.IsImmutableOverlapMountpoint(m.Target) {
+		return reject(syscall.EPERM)
+	}
+	r, err := sysfstransfer.Acquire(m.cntr, m.pid, m.uid, m.gid, m.Target, m.Flags, "", nil)
+	if err != nil {
+		return reject(err)
+	}
+	defer r.Close()
+	guard, ok := m.tracer.service.nss.(interface{ WithChildReaperGuard(func() error) error })
+	if !ok {
+		return reject(syscall.ENOTSUP)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 25*time.Second)
+	defer cancel()
+	err = sysfstransfer.Run(ctx, helper, r, guard, func(run func() ([]byte, error)) ([]byte, error) { return runProcTransfer(m.notifyFd, m.reqId, run) })
+	if err != nil {
+		return reject(err)
+	}
+	return m.tracer.createSuccessResponse(m.reqId), true, nil
+}
