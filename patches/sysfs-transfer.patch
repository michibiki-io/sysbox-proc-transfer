+// Getattr carries the actual FUSE caller (Attr has no request PID). Refresh the
+// virtual-net metadata even when another caller has already obtained this node.
+func (f *File) Getattr(ctx context.Context, req *fuse.GetattrRequest, resp *fuse.GetattrResponse) error {
+	if !networkUncached(f.path) {
+		return f.Attr(ctx, &resp.Attr)
+	}
+	if f.server.requestContainer(f.path) == nil {
+		return fuse.EIO
+	}
+	n := f.server.service.ios.NewIOnode(f.name, f.path, 0)
+	handler, ok := f.server.service.hds.LookupHandler(n)
+	if !ok {
+		return fuse.EIO
+	}
+	hr := &domain.HandlerRequest{ID: uint64(req.ID), Path: f.path, Name: f.name, Pid: req.Pid, Uid: req.Uid, Gid: req.Gid, Container: f.server.requestContainer(f.path)}
+	info, err := handler.Lookup(n, hr)
+	if err != nil {
+		return networkError(err)
+	}
+	a := convertFileInfoToFuse(info)
+	a.Mode = info.Mode() & ^os.ModeType | f.attr.Mode.Type()
+	a.Valid = 0
+	a.Inode = f.attr.Inode
+	if !hr.SkipIdRemap {
+		prs := f.server.service.hds.ProcessService()
+		p := prs.ProcessCreate(req.Pid, req.Uid, req.Gid)
+		a.Uid, a.Gid, err = p.UsernsRootUidGid()
+		if err != nil {
+			return networkError(err)
+		}
+	}
+	resp.Attr = a
+	return nil
+}
